# Forensic Auditor Backend Environment Configuration
PROJECT_NAME="Forensic Auditor AML Engine"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=True

# CORS - Allowed origins separated by commas
BACKEND_CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Database Configuration (TigerData PostgreSQL + pgvector)
DATABASE_URL="postgresql+asyncpg://user:password@localhost:5432/tsdb"
POSTGRES_TIMEOUT=30.0

# External Integrations
N8N_WEBHOOK_URL="http://localhost:5678/webhook/investigation-stream"
N8N_TIMEOUT=60.0
ELEVENLABS_API_KEY="your_elevenlabs_api_key_here"
ELEVENLABS_VOICE_ID="21m00Tcm4TlvDq8ikWAM"
ELEVENLABS_MODEL_ID="eleven_multilingual_v2"
# Safety guard: True = block external API calls and use synthetic fallback (saves quota in tests/dev)
ELEVENLABS_SAFE_MODE=True

# Graph Algorithm Config
MAX_CYCLE_LENGTH=5
PASS_THROUGH_RATIO_THRESHOLD=0.90
PASS_THROUGH_WINDOW_HOURS=48.0

# LLM Usage Estimation (reported when Gemini metadata is unavailable)
LLM_CALLS_ESTIMATE_MIN=10
LLM_CALLS_ESTIMATE_MAX=22
LLM_TOKENS_ESTIMATE_MIN=5000
LLM_TOKENS_ESTIMATE_MAX=8300
GEMINI_MXN_PER_1K_TOKENS=0.012
